{
  "realm": "fraud-detection",
  "enabled": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "fraud-analyst-ui",
      "name": "Fraud Analyst UI",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "fraud-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "fraud-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "analyst",
      "enabled": true,
      "email": "analyst@example.com",
      "emailVerified": true,
      "firstName": "Fraud",
      "lastName": "Analyst",
      "credentials": [
        { "type": "password", "value": "analyst", "temporary": false }
      ]
    }
  ]
}
